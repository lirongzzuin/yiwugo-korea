# apps/web — Next.js 웹 앱 환경변수 예시 (값은 모두 플레이스홀더)

# 이우고 Open Platform (OAuth client_credentials)
YIWUGO_API_BASE_URL=https://open.yiwugo.com
YIWUGO_CLIENT_ID=your_client_id
YIWUGO_CLIENT_SECRET=your_client_secret

# 한국수출입은행 환율 API (없으면 공개 환율 API → 고정값 순으로 폴백)
KOREA_EXIM_API_KEY=

# 번역 프리페치 크론 보호용 (설정 시 Authorization: Bearer <값> 검증)
CRON_SECRET=

# 토스페이먼츠 결제위젯 클라이언트 키 (테스트 키는 test_ck_ 로 시작)
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_client_key

# 외부 백엔드(NestJS) 주소. 비우면 /api (Next.js Route Handler) 사용
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=YiwuGo Korea

# 소셜 로그인 (선택)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
