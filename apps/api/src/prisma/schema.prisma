generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum AuthProvider {
  KAKAO
  NAVER
  APPLE
  EMAIL
  YIWUGO
}

enum MemberType {
  INDIVIDUAL
  BUSINESS
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  ORDERED_TO_YIWUGO
  YIWUGO_CONFIRMED
  PREPARING
  SHIPPING_FROM_CHINA
  IN_TRANSIT
  IN_CUSTOMS
  CUSTOMS_CLEARED
  DOMESTIC_SHIPPING
  DELIVERED
  PURCHASE_CONFIRMED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum ShippingMethod {
  AIR
  SEA
}

enum PaymentProvider {
  TOSS_PAYMENTS
  KAKAO_PAY
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUNDED
}

enum CouponType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  SHIPPING
  CUSTOMS
  PRICE_DROP
  COUPON
  POINT
  EVENT
  NOTICE
  REVIEW_REMINDER
  SYSTEM
}

enum SettlementStatus {
  DRAFT
  CONFIRMED
  PAID_TO_YIWUGO
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  CATEGORY
  SEARCH
}

enum NoticeCategory {
  GENERAL
  EVENT
  MAINTENANCE
  POLICY
}

enum PointAction {
  EARN_PURCHASE
  EARN_REVIEW
  EARN_SIGNUP
  EARN_REFERRAL
  EARN_EVENT
  USE_ORDER
  EXPIRE
  ADMIN_ADJUST
}

// ─── User ────────────────────────────────────────────────

model User {
  id                String       @id @default(uuid())
  email             String?      @unique
  passwordHash      String?
  name              String?
  phone             String?      @unique
  provider          AuthProvider?
  providerId        String?
  memberType        MemberType   @default(INDIVIDUAL)
  businessNumber    String?
  businessName      String?
  yiwugoUserId      String?      @unique
  role              Role         @default(USER)
  customsCode       String?
  points            Int          @default(0)
  isEmailVerified   Boolean      @default(false)
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  marketingConsent  Boolean      @default(false)
  refreshToken      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  addresses         Address[]
  orders            Order[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  notifications     Notification[]
  userCoupons       UserCoupon[]
  pointHistories    PointHistory[]
  inquiries         Inquiry[]
  auditLogs         AuditLog[]     @relation("AuditAdmin")

  @@index([provider, providerId])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String?
  name      String
  phone     String
  zipCode   String
  address1  String
  address2  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─── Product ─────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid())
  code     String  @unique
  nameZh   String
  nameKo   String
  icon     String?
  slug     String  @unique
  parentId String?
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  products     Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Shop {
  id              String   @id @default(uuid())
  sellerId        String   @unique
  nameOriginal    String
  nameKo          String
  boothNumber     String?
  description     String?
  descriptionKo   String?
  panoramaUrl     String?
  logoUrl         String?
  productCount    Int      @default(0)
  responseRate    Float?
  yearsInBusiness Int?
  isVerified      Boolean  @default(false)
  categories      String[] @default([])
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]

  @@index([sellerId])
  @@map("shops")
}

model Product {
  id              String   @id @default(uuid())
  yiwugoId        String   @unique
  titleOriginal   String
  titleKo         String
  titleKoManual   String?
  descOriginal    String?
  descKo          String?
  priceOriginalCny Decimal @db.Decimal(12, 2)
  priceKrw        Decimal  @db.Decimal(14, 0)
  originalPriceKrw Decimal? @db.Decimal(14, 0)
  minOrderQty     Int      @default(1)
  stock           Int?
  imageUrls       String[] @default([])
  imageProxyUrls  String[] @default([])
  categoryId      String?
  subCategoryId   String?
  shopId          String?
  detailUrl       String?
  options         Json?
  optionsKo       Json?
  specs           Json?
  specsKo         Json?
  weight          String?
  viewCount       Int      @default(0)
  salesCount      Int      @default(0)
  wishlistCount   Int      @default(0)
  reviewCount     Int      @default(0)
  averageRating   Float?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      Category?      @relation(fields: [categoryId], references: [id])
  shop          Shop?          @relation(fields: [shopId], references: [id])
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  priceHistory  PriceHistory[]

  @@index([categoryId])
  @@index([shopId])
  @@index([priceKrw])
  @@index([salesCount])
  @@index([createdAt])
  @@index([isActive, isFeatured])
  @@map("products")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  priceCny  Decimal  @db.Decimal(12, 2)
  priceKrw  Decimal  @db.Decimal(14, 0)
  rate      Decimal  @db.Decimal(10, 4)
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ─── Cart ────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  options   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, options])
  @@index([userId])
  @@map("cart_items")
}

// ─── Wishlist ────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─── Order ───────────────────────────────────────────────

model Order {
  id                  String       @id @default(uuid())
  orderNumber         String       @unique
  userId              String
  status              OrderStatus  @default(PENDING)
  totalKrw            Decimal      @db.Decimal(14, 0)
  totalCny            Decimal      @db.Decimal(12, 2)
  shippingFeeKrw      Decimal      @db.Decimal(14, 0) @default(0)
  discountKrw         Decimal      @db.Decimal(14, 0) @default(0)
  pointsUsed          Int          @default(0)
  commissionKrw       Decimal      @db.Decimal(14, 0) @default(0)
  exchangeRate        Decimal      @db.Decimal(10, 4)
  commissionRate      Decimal      @db.Decimal(5, 4)
  shippingAddressId   String?
  customsCode         String?
  shippingMethod      ShippingMethod @default(AIR)
  trackingNumbers     Json?
  yiwugoOrderId       String?
  couponId            String?
  deliveryMemo        String?
  estimatedDelivery   DateTime?
  purchaseConfirmedAt DateTime?
  cancelReason        String?
  adminMemo           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  shippingAddress Address?      @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  refunds         Refund[]
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  priceKrw    Decimal @db.Decimal(14, 0)
  priceCny    Decimal @db.Decimal(12, 2)
  options     Json?
  imageUrl    String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─── Payment ─────────────────────────────────────────────

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @unique
  provider          PaymentProvider
  providerPaymentId String?
  paymentKey        String?         @unique
  method            String?
  amount            Decimal         @db.Decimal(14, 0)
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?
  cancelledAt       DateTime?
  receiptUrl        String?
  cashReceiptIssued Boolean         @default(false)
  rawResponse       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([paymentKey])
  @@index([status])
  @@map("payments")
}

// ─── Refund ──────────────────────────────────────────────

model Refund {
  id            String       @id @default(uuid())
  orderId       String
  status        RefundStatus @default(REQUESTED)
  reason        String
  amount        Decimal      @db.Decimal(14, 0)
  adminNote     String?
  images        String[]     @default([])
  processedAt   DateTime?
  processedBy   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ─── Review ──────────────────────────────────────────────

model Review {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  orderId       String?
  rating        Int
  content       String?
  images        String[] @default([])
  qualityGood   Boolean?
  deliveryGood  Boolean?
  transAccurate Boolean?
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId, orderId])
  @@index([productId, createdAt])
  @@index([userId])
  @@map("reviews")
}

// ─── Coupon ──────────────────────────────────────────────

model Coupon {
  id               String     @id @default(uuid())
  code             String     @unique
  name             String
  description      String?
  type             CouponType
  value            Decimal    @db.Decimal(14, 2)
  minOrderAmount   Decimal?   @db.Decimal(14, 0)
  maxDiscountAmount Decimal?  @db.Decimal(14, 0)
  categoryId       String?
  totalQuantity    Int?
  usedQuantity     Int        @default(0)
  startsAt         DateTime
  expiresAt        DateTime
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  userCoupons UserCoupon[]

  @@index([code])
  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

model UserCoupon {
  id         String    @id @default(uuid())
  userId     String
  couponId   String
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  orderId    String?
  receivedAt DateTime  @default(now())
  expiresAt  DateTime

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@index([userId])
  @@map("user_coupons")
}

// ─── Points ──────────────────────────────────────────────

model PointHistory {
  id          String      @id @default(uuid())
  userId      String
  action      PointAction
  amount      Int
  balance     Int
  description String?
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("point_history")
}

// ─── Notification ────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  linkUrl   String?
  imageUrl  String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── Inquiry ─────────────────────────────────────────────

model Inquiry {
  id          String        @id @default(uuid())
  userId      String
  category    String
  subject     String
  content     String
  images      String[]      @default([])
  status      InquiryStatus @default(OPEN)
  orderId     String?
  productId   String?
  adminReply  String?
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("inquiries")
}

// ─── Settlement ──────────────────────────────────────────

model Settlement {
  id                    String           @id @default(uuid())
  status                SettlementStatus @default(DRAFT)
  periodStart           DateTime
  periodEnd             DateTime
  orderIds              String[]         @default([])
  totalOrderAmountKrw   Decimal          @db.Decimal(14, 0)
  totalOrderAmountCny   Decimal          @db.Decimal(12, 2)
  totalCommissionKrw    Decimal          @db.Decimal(14, 0)
  totalShippingCny      Decimal          @db.Decimal(12, 2)
  exchangeRateUsed      Decimal          @db.Decimal(10, 4)
  settlementAmountCny   Decimal          @db.Decimal(12, 2)
  remittanceRef         String?
  confirmedAt           DateTime?
  paidAt                DateTime?
  adminNote             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("settlements")
}

// ─── Exchange Rate ───────────────────────────────────────

model ExchangeRate {
  id         String   @id @default(uuid())
  fromCurrency String @default("CNY")
  toCurrency   String @default("KRW")
  rate       Decimal  @db.Decimal(10, 4)
  source     String   @default("manual")
  recordedAt DateTime @default(now())

  @@index([fromCurrency, toCurrency, recordedAt])
  @@map("exchange_rates")
}

// ─── Content (CMS) ──────────────────────────────────────

model Banner {
  id        String         @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  BannerPosition @default(HOME_TOP)
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([position, isActive])
  @@map("banners")
}

model Notice {
  id          String         @id @default(uuid())
  title       String
  content     String
  category    NoticeCategory @default(GENERAL)
  isPinned    Boolean        @default(false)
  isPublished Boolean        @default(false)
  viewCount   Int            @default(0)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isPublished, isPinned, createdAt])
  @@map("notices")
}

model FAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
  @@map("faqs")
}

model StaticPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("static_pages")
}

// ─── Audit ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ipAddress  String
  userAgent  String?
  createdAt  DateTime @default(now())

  admin User @relation("AuditAdmin", fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Translation Cache ───────────────────────────────────

model TranslationCache {
  id         String   @id @default(uuid())
  sourceHash String   @unique
  sourceText String
  targetText String
  sourceLang String   @default("zh-CN")
  targetLang String   @default("ko")
  provider   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sourceLang, targetLang])
  @@map("translation_cache")
}

// ─── Recommendation / User Behavior ─────────────────────

enum UserActionType {
  VIEW
  CLICK
  WISHLIST
  CART
  PURCHASE
  SEARCH
}

model UserActivity {
  id         String         @id @default(uuid())
  userId     String
  productId  String?
  categoryId String?
  actionType UserActionType
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([userId, actionType, createdAt])
  @@index([userId, categoryId])
  @@index([productId, actionType])
  @@index([createdAt])
  @@map("user_activities")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  categoryScores   Json     @default("{}")
  priceRangeLow    Decimal? @db.Decimal(14, 0)
  priceRangeHigh   Decimal? @db.Decimal(14, 0)
  favoriteShopIds  String[] @default([])
  lastComputedAt   DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("user_preferences")
}

// ─── System Settings ─────────────────────────────────────

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
