# ============================================
# YiwuGo Korea - Environment Variables
# ============================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/yiwugo_korea?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- Meilisearch ----
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ---- Yiwugo API ----
YIWUGO_API_BASE_URL=https://api.yiwugo.com
YIWUGO_API_KEY=
YIWUGO_API_SECRET=
YIWUGO_PARTNER_ID=

# ---- Translation (Papago / DeepL) ----
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
DEEPL_API_KEY=

# ---- Exchange Rate ----
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4

# ---- Payment (Toss Payments) ----
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_WEBHOOK_SECRET=

# ---- OAuth (Kakao / Naver / Google) ----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/auth/kakao/callback

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:4000/auth/naver/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- JWT ----
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ---- File Storage (AWS S3) ----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=yiwugo-korea
AWS_CLOUDFRONT_DOMAIN=

# ---- Business ----
BUSINESS_REGISTRATION_API_KEY=
CUSTOMS_API_KEY=

# ---- Notification (Aligo SMS / Email) ----
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yiwugo.kr

# ---- FCM (Firebase Cloud Messaging) ----
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ---- Security ----
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- Analytics ----
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
AMPLITUDE_API_KEY=

# ---- Sentry ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- Shipping ----
SHIPPING_TRACKER_API_KEY=
CJ_LOGISTICS_API_KEY=
LOTTE_LOGISTICS_API_KEY=
HANJIN_API_KEY=
